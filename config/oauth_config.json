{
  "integrations": {
    "asana": {
      "display_name": "Asana",
      "client_id": "<your-asana-client-id>",
      "client_secret": "<your-asana-client-secret>",
      "authorize_url": "https://<%= oauth_iparams.host %>/-/oauth_authorize",
      "token_url": "https://<%= oauth_iparams.host %>/-/oauth_token",
      "options": {
        "scope": "default"
      },
      "token_type": "account",
      "oauth_iparams": {
        "host": {
          "display_name": "host",
          "description": "Enter app.asana.com",
          "type": "text",
          "required": true
        }
      }
    }
  }
}
